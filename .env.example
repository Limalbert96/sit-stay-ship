# Copy to .env and fill in the lines marked YOU. .env is git-ignored: never commit it.
# Every line below is live. An empty value means "not set", and that feature stays off.

# --- LaunchDarkly ---
# YOU: API access token. LaunchDarkly: Account settings, Authorization, Access tokens, role Admin
# (needed the first time, when setup creates the cgc-demo project; Writer is enough after that).
# Used ONLY by the scripts (setup, teardown, incident). It is NOT the SDK key; the app never reads it.
# Left empty, `npm run setup` asks for it in the terminal and can save it here.
LD_API_TOKEN=
# `npm run setup` fills in these two (the same environment for both). Leave them empty.
#   Client-side ID: used by the browser SDK. Safe to expose.
LD_CLIENT_ID=
#   Server-side SDK key: used only by server/ and scripts/. SECRET, never sent to the browser.
LD_SDK_KEY=
# `npm run setup` also writes LD_PROJECT_KEY, LD_ENV_KEY and LD_TRIGGER_URL (the kill switch URL,
# a secret). You do not add them.

# --- New Relic (leave these empty to run without it) ---
# YOU: Browser agent (React app). New Relic: Add data, Browser monitoring, copy/paste snippet.
NR_ACCOUNT_ID=
NR_BROWSER_APP_ID=
NR_BROWSER_LICENSE_KEY=
# YOU: APM agent (Node backend). New Relic: Add data, Node.js. NR_APM_APP_NAME must be the name BOTH
# apps report under: setup finds each app's entity.guid by this name.
NR_APM_APP_NAME="Canine Good Citizen"
NR_APM_LICENSE_KEY=
# Optional: New Relic AI monitoring for the chatbot's model calls (on when "true").
NR_APM_AIM_ENABLED=true
# YOU: New Relic USER key (profile menu, API keys, Create key, type User). With it `npm run setup`
# also wires LaunchDarkly and New Relic both ways: flag-change markers on both apps, the rage-click
# alert, and the automated kill switch (created OFF). The license keys above cannot do this.
NR_USER_KEY=
# Only if this folder has no Terraform state for the New Relic trigger (made by hand, or set up from
# another machine): its id, the segment after /webhook/triggers/ in the trigger URL. Lets
# `npm run incident -- --auto-remediation` confirm that trigger fired.
# NR_TRIGGER_ID=
# EU New Relic accounts only: NerdGraph is at api.eu.newrelic.com.
# NR_API_URL=https://api.eu.newrelic.com/graphql

# --- Chatbot replies (optional) ---
# The AI Config names each model, and the backend runs it where it belongs:
#   "gpt-..." models    -> OpenAI, if OPENAI_API_KEY is set
#   any other model     -> a local Ollama server (free, https://ollama.com), if it has that model
#   otherwise           -> canned replies
OPENAI_API_KEY=
# Only if Ollama is not at its default address:
# OLLAMA_URL=http://localhost:11434
