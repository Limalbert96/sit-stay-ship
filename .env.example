# Copy to .env and fill in. .env is git-ignored. `npm run setup` fills in the LaunchDarkly
# values below for you; you only need to provide LD_API_TOKEN (or export it in your shell).

# --- LaunchDarkly account access (setup and teardown only) ---
# API access token: LaunchDarkly, Account settings, Authorization, Access tokens, role Writer.
# Used ONLY by `npm run setup` and `npm run teardown` (Terraform and the API). It is powerful:
# never commit it. It is NOT the SDK key and the app itself never reads it.
# If it is missing, `npm run setup` asks for it in the terminal and can save it here for you.
LD_API_TOKEN=your-api-access-token

# Which LaunchDarkly project and environment the scripts use by default. `npm run setup` writes
# these, so `npm run experiments` and `npm run teardown` act on the project you set up.
# LD_PROJECT_KEY=default
# LD_ENV_KEY=test

# --- LaunchDarkly SDK settings (written by `npm run setup`; both from the SAME environment) ---
# Client-side ID: used by the browser SDK. Safe to expose.
LD_CLIENT_ID=your-client-side-id
# Server-side SDK key: used ONLY by server/ and scripts/ (AI Config and traffic simulation).
# SECRET, never sent to the browser.
LD_SDK_KEY=sdk-your-server-side-key
# URL of the flag trigger (Turn flag off) for premium-video-tutorials. Secret: never commit it.
# Used by the "Fire kill switch" button and by curl -X POST "<this url>".
# LD_TRIGGER_URL=https://app.launchdarkly.com/webhook/triggers/...

# --- Optional: where chatbot replies come from ---
# The AI Config names each model, and the backend runs it where it belongs:
#   "gpt-..." models    -> OpenAI, if OPENAI_API_KEY is set
#   any other model     -> a local Ollama server (free, https://ollama.com), if it has that model
#   otherwise           -> canned replies
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://localhost:11434

# --- Optional: New Relic (leave these commented out to run without it) ---
# `npm run setup` does not set up New Relic. Create the account and apps yourself, then
# uncomment and fill these in. Placeholder values would start the agents with fake IDs.
# Browser agent (React app). New Relic: Add data -> Browser monitoring -> snippet.
# NR_ACCOUNT_ID=your-account-id
# NR_BROWSER_APP_ID=your-browser-application-id
# NR_BROWSER_LICENSE_KEY=your-browser-license-key
# APM agent (Node backend). New Relic: Add data -> Node.js.
# NR_APM_APP_NAME="Canine Good Citizen"
# NR_APM_LICENSE_KEY=your-apm-license-key
# NR_APM_AIM_ENABLED=true
